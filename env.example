# JARVIS Computer Assistant - Environment Variables
# Copy this file to .env and configure your settings

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=JARVIS Computer Assistant
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# REST API Server
REST_HOST=localhost
REST_PORT=8080
REST_WORKERS=4

# WebSocket Server
WS_HOST=localhost
WS_PORT=8765
WS_MAX_CONNECTIONS=100

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite Database
DATABASE_URL=sqlite:///data/jarvis.db
DATABASE_ECHO=false

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================
# Default AI Provider (ollama, openai, gemini, openrouter)
DEFAULT_AI_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=2048

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_ORGANIZATION=your_org_id_here

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=8192

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=4096

# =============================================================================
# VOICE RECOGNITION CONFIGURATION
# =============================================================================
# Speech Recognition
VOICE_ENGINE=google
VOICE_LANGUAGE=tr-TR
VOICE_TIMEOUT=5
VOICE_PHRASE_TIMEOUT=0.3
VOICE_NON_SPEAKING_DURATION=0.8

# Text-to-Speech
TTS_ENGINE=edge
TTS_LANGUAGE=tr
TTS_VOICE=tr-TR-AhmetNeural
TTS_RATE=150
TTS_VOLUME=0.9

# Wake Word Detection
WAKE_WORDS=hey alimer,hey asistan,merhaba asistan
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_TIMEOUT=3

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your_encryption_key_here
ENCRYPTION_ALGORITHM=AES-256-GCM

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Logging
LOG_FORMAT=json
LOG_FILE=data/logs/jarvis.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_ROTATION=daily

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10

# =============================================================================
# PLUGIN SYSTEM
# =============================================================================
# Plugin Configuration
PLUGINS_ENABLED=true
PLUGINS_DIR=plugins
PLUGIN_AUTO_LOAD=true
PLUGIN_HOT_RELOAD=false

# =============================================================================
# FILE AND STORAGE
# =============================================================================
# Data Directories
DATA_DIR=data
BACKUP_DIR=data/backups
CACHE_DIR=data/cache
TEMP_DIR=data/temp
LOGS_DIR=data/logs

# File Upload
MAX_UPLOAD_SIZE=100MB
ALLOWED_EXTENSIONS=pdf,txt,doc,docx,md

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# Webhook Configuration
WEBHOOK_URL=
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development Mode
DEV_MODE=false
DEV_AUTO_RELOAD=true
DEV_DEBUG_TOOLBAR=false

# Testing
TEST_DATABASE_URL=sqlite:///:memory:
TEST_REDIS_URL=redis://localhost:6379/1

# =============================================================================
# FLUTTER CLIENT CONFIGURATION
# =============================================================================
# Mobile App Settings
FLUTTER_APP_NAME=JARVIS Assistant
FLUTTER_APP_VERSION=1.0.0
FLUTTER_PACKAGE_NAME=com.jarvis.assistant
FLUTTER_ICON_PATH=assets/icons/app_icon.png

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Memory Management
MAX_MEMORY_USAGE_MB=500
MEMORY_CLEANUP_INTERVAL=300

# CPU Management
MAX_CPU_USAGE_PERCENT=80
CPU_MONITORING_INTERVAL=60

# Connection Pooling
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20
DB_POOL_TIMEOUT=30

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature Toggles
FEATURE_VOICE_RECOGNITION=true
FEATURE_AI_INTEGRATION=true
FEATURE_REMOTE_CONTROL=true
FEATURE_PLUGIN_SYSTEM=true
FEATURE_MONITORING=true
FEATURE_ANALYTICS=true
FEATURE_MULTI_USER=true
FEATURE_CLOUD_SYNC=false

# =============================================================================
# CUSTOM SETTINGS
# =============================================================================
# Add your custom environment variables here
# CUSTOM_SETTING_1=value1
# CUSTOM_SETTING_2=value2
